# LLM Provider: "mock", "gemini", or "openai"
LLM_PROVIDER=mock

# API Keys (optional if using mock mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Routing
FAST_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o

# Database Configuration (Postgres+pgvector or local SQLite)
DATABASE_URL=sqlite:///backend/soil_twin.db
# For Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://soiltwin_user:soiltwin_password@localhost:5432/soiltwin_db

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Agentic constraints
MAX_RETRIES=2
TOP_K_RETRIEVAL=3
